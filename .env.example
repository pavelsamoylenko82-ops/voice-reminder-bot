# Скопируйте в .env (рядом с main.py) или в /app/.env на сервере.
# Реальные переменные окружения имеют приоритет над .env.

BOT_TOKEN=8406940174:AAGDxk-G6NQg_BRCYiErIbUeFqraUIr1eVQ
OPENAI_API_KEY=sk-fc-brUkPKHb4iXRDA7N4mrkVtD1I-DpCQt6-lAJkGGjflA
OPENAI_BASE_URL=https://freecodex.fun/v1

# Порядок перебора моделей через запятую.
OPENAI_MODELS=gemini-3.8-flash,gemini-3-flash,gemini-3.1-pro

# Абсолютный путь к SQLite. В Docker по умолчанию /app/data/reminders.db.
# DB_PATH=/app/data/reminders.db

# Анти-игнор: повторный пинг каждые N минут, максимум M уведомлений.
REMINDER_RETRY_MINUTES=10
REMINDER_MAX_RETRIES=3
SCHEDULER_TICK_SECONDS=10

# Таймаут запроса к LLM, секунд.
AI_TIMEOUT_SECONDS=60

# 1 = всегда отправлять текст в LLM (медленнее, но полезно для сложных фраз).
# 0 = быстрый локальный парсер для простых явных временных форматов.
AI_ALWAYS=0

# --- Список покупок и Бот Финансов ---
CURRENCY=BYN
# Внутренний адрес Finance API. Если боты в одной Docker-сети family_bots:
FINANCE_API_URL=http://finance_tracker_bot:8081/api/expenses
# Должен совпадать с FINANCE_API_TOKEN в .env финансового бота (если задан).
FINANCE_API_TOKEN=
FINANCE_CATEGORY=Продукты
# Таймаут запроса к финансовому боту, секунд.
FINANCE_API_TIMEOUT=15
SHOP_DISPLAY_LIMIT=45
SHOP_BUTTON_LIMIT=45

LOG_LEVEL=INFO
